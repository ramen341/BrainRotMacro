def preprocess_image(image):
    #Enhance image for better OCR accuracy
    # Convert to grayscale
    image = image.convert('L')
    
    # Increase contrast
    enhancer = ImageEnhance.Contrast(image)
    image = enhancer.enhance(2.5)
    
    # Increase sharpness
    enhancer = ImageEnhance.Sharpness(image)
    image = enhancer.enhance(1.0)
    image = image.point(lambda x: 255 if x > 180 else 0)
    return image

#Time variables
duration = 886
startTime = time.time()


#Check for good brainrot

TARGET_NAMES = [
    "Tralaledon",
    "Los Primos",
    "Eviledon",
    "Orcaledon",
    "Capitano Moby"
]
def isGoodBrainrot():
    #Take and save a screenshot as a file
    screenshot = pyautogui.screenshot(region=(700, 50, 300, 700))
    enchanced_image = preprocess_image(screenshot)
    enchanced_image.save("brainRot.png")
    text = pytesseract.image_to_string(enchanced_image, config="--psm 6")
    print(f"text:{text}")
    for name in TARGET_NAMES:
        print(fuzz.partial_ratio(name.lower(), text.lower()))
        if fuzz.partial_ratio(name.lower(), text.lower()) > 86:
            print(f"Found target brainrot: {name}")
            return True
    print("No target brainrot found.")
    return False
